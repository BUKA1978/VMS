<Window x:Class="FVR.Monitoring.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FVR VMS 4.0 - Monitoring Client Etapa 10" Width="1440" Height="900" MinWidth="1100" MinHeight="700" Background="{StaticResource Bg}" Foreground="White" WindowStartupLocation="CenterScreen">
<Grid>
 <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Background="#11151C" BorderBrush="#262D38" BorderThickness="0,0,0,1"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="FVR VMS 4.0" FontSize="20" FontWeight="Bold"/><TextBlock Text="MONITORING CLIENT • ETAPA 10 • WINDOWS NATIVE" Foreground="#8D96A5" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Text="--:--:--" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#AAB2BF"/><Button Content="VIDEO WALL" Click="VideoWall_Click" Background="#D71920"/><Button Content="SAIR" Click="Exit_Click"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#11151C" BorderBrush="#262D38" BorderThickness="0,0,1,0"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="CÂMERAS" FontWeight="Bold" FontSize="13"/><TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,10,0,10" Height="30" Text="Buscar câmera..." Foreground="#7F8896" Background="#0D1015" BorderBrush="#343C49" Padding="8,5"/><ListBox x:Name="CameraList" Grid.Row="2" Background="#0D1015" Foreground="White" BorderBrush="#343C49" SelectionMode="Extended"><ListBoxItem>Portaria Principal</ListBoxItem><ListBoxItem>Entrada Veículos</ListBoxItem><ListBoxItem>Recepção</ListBoxItem><ListBoxItem>Estacionamento A</ListBoxItem><ListBoxItem>Estacionamento B</ListBoxItem><ListBoxItem>Corredor Norte</ListBoxItem><ListBoxItem>Corredor Sul</ListBoxItem><ListBoxItem>Doca 01</ListBoxItem><ListBoxItem>Doca 02</ListBoxItem><ListBoxItem>Perímetro Leste</ListBoxItem><ListBoxItem>Perímetro Oeste</ListBoxItem><ListBoxItem>Almoxarifado</ListBoxItem></ListBox><StackPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="ABRIR SELECIONADA" Click="OpenSelected_Click" Background="#D71920"/><Button Content="E-MAP / LAYOUTS" Click="EMap_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Column="1" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="MOSAICO" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/><Button Content="1x1" Click="Grid1_Click"/><Button Content="2x2" Click="Grid2_Click" Background="#D71920"/><Button Content="3x3" Click="Grid3_Click"/><Button Content="4x4" Click="Grid4_Click"/><Button Content="8x8" Click="Grid8_Click"/><Separator Width="15" Opacity="0"/><Button x:Name="AudioButton" Content="ÁUDIO OFF" Click="Audio_Click"/><Button x:Name="ZoomButton" Content="ZOOM 1x" Click="Zoom_Click"/><TextBlock x:Name="ModeText" Text=" GPU: AUTO • PERFIL: BALANCEADO • STREAM: ADAPTATIVO" VerticalAlignment="Center" Foreground="#8D96A5" Margin="12,0,0,0"/></WrapPanel><UniformGrid x:Name="VideoGrid" Grid.Row="2" Rows="2" Columns="2"/></Grid>
 </Grid>
 <Border Grid.Row="2" Background="#11151C" BorderBrush="#262D38" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="PRONTO • BUILD WINDOWS NATIVE" VerticalAlignment="Center" Foreground="#8D96A5"/><TextBlock Grid.Column="1" Text="FVR VMS 4.0 • ETAPA 10 PREVIEW" VerticalAlignment="Center" Foreground="#687181"/></Grid></Border>
</Grid></Window>
