<Window x:Class="FVR.MonitoringClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FVR Monitoring Client — Login"
        Width="460" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1D23">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="42" Width="360">
            <TextBlock Text="FVR" FontSize="42" FontWeight="Bold" Foreground="#4FC3F7"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="VMS 4.0.2 — Monitoring Client" FontSize="14" Foreground="#9AA5B1"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="Management Server" Foreground="#C9D1D9" Margin="0,0,0,4"/>
            <TextBox x:Name="ServerBox" Height="34" Padding="8,6"
                     Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                     Background="#252932" Foreground="White" BorderBrush="#3A3F4B"/>
            <TextBlock Text="Ex.: 127.0.0.1 ou 192.168.1.100 — porta padrão 5000"
                       FontSize="11" Foreground="#7D8590" Margin="0,5,0,18"/>

            <TextBlock Text="Usuário" Foreground="#C9D1D9" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" Height="34" Padding="8,6"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Background="#252932" Foreground="White" BorderBrush="#3A3F4B"/>

            <TextBlock Text="Senha" Foreground="#C9D1D9" Margin="0,16,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Padding="8,6"
                         Background="#252932" Foreground="White" BorderBrush="#3A3F4B"
                         KeyDown="PasswordBox_KeyDown"/>

            <Border Background="#20242C" BorderBrush="#343A46" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,14,0,0">
                <TextBlock Text="Na mesma máquina do servidor use 127.0.0.1. Em outro computador, informe o IP do Windows onde o FVR Management Server foi instalado."
                           Foreground="#9AA5B1" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF5350" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button x:Name="LoginButton" Content="Conectar e Entrar" Height="40" Margin="0,22,0,0"
                    Background="#4FC3F7" Foreground="#0B1015" FontWeight="SemiBold" BorderThickness="0"
                    Click="LoginButton_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
